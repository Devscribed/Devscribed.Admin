{
  "name": "devscribed-admin",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "apps/*",
    "e2e"
  ],
  "scripts": {
    "test:unit": "npm run test --workspace @devscribed/validation",
    "test:int": "npm run test --workspace @devscribed/api",
    "test:e2e": "npm run test --workspace @devscribed/e2e",
    "dev": "npm run dev --workspace @devscribed/api & npm run dev --workspace @devscribed/web",
    "build": "npm run build --workspaces --if-present",
    "release": "release-it",
    "release:dry": "release-it --dry-run",
    "spec": "node scripts/claude-cmd.mjs spec",
    "bug": "node scripts/claude-cmd.mjs bug",
    "ship": "node scripts/claude-cmd.mjs ship",
    "ship:run": "node scripts/ship.mjs",
    "board": "node scripts/run-watch.mjs --open",
    "watch": "node scripts/run-watch.mjs",
    "wf": "node scripts/wf.mjs",
    "wf:status": "node scripts/wf.mjs status",
    "wf:log": "node scripts/wf.mjs log",
    "gate": "node scripts/static-gate.mjs",
    "coverage": "node scripts/handoff-coverage.mjs"
  },
  "devDependencies": {
    "release-it": "21.0.2"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.252"
  }
}
