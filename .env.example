# Copy to .env and adjust as needed. Do not commit .env.

# --- Database (matches docker-compose.yml) ---
DATABASE_HOST=localhost
# Host port 5433 to avoid clashing with a native Postgres on 5432 (see docker-compose.yml).
DATABASE_PORT=5433
DATABASE_USER=devscribed
DATABASE_PASSWORD=devscribed
DATABASE_NAME=devscribed_admin
DATABASE_NAME_TEST=devscribed_admin_test

# --- API (NestJS) ---
API_PORT=4000
JWT_SECRET=dev-only-change-me
SESSION_COOKIE_NAME=ds_session
# Session lifetime in seconds (24h)
SESSION_TTL=86400

# --- Web (Next.js) ---
WEB_PORT=3000
# The web app talks to the API through a same-origin rewrite (see next.config.js).
NEXT_PUBLIC_API_BASE_URL=/api
