        "selector": "JSXOpeningElement[name.name='ConfirmDialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|description|acceptBtnText|declineBtnText|onClose|onAccept|transparentOverlay|key|ref|className|style|children)$/]",
