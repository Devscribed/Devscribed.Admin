        "selector": "JSXOpeningElement[name.name='CircleSelectOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|key|ref|className|style|children)$/]",
        "message": "<CircleSelectOption> doesn't accept that prop. Declared props: label, value."
