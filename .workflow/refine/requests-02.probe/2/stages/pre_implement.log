nexport default async function globalSetup(globalConfig: { maxWorkers?: number }): Promise<void> {\n  execSync('npx prisma migrate deploy', {\n    cwd: join(__dirname, '..'),\n    env: {\n      ...process.env,\n      DATABASE_URL: BASE_TEST_DATABASE_URL,\n      // Nothing pools in front of a local Postgres, so migrations use the same URL.\n      DIRECT_URL: BASE_TEST_DATABASE_URL,\n    },\n    stdio: 'inherit',\n  });\n\n  const workers = Math.max(1, globalConfig.maxWorkers ?? 1);\n  if (workers === 1) return;","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
