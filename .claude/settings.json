{
  "$comment": "Project settings, checked in. The hooks below are the pipeline's journal and its one hard refusal; see docs/ai-workflow.md.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-protected-branch.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/run-logger.mjs\" tool-pre",
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/run-logger.mjs\" tool-post",
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/run-logger.mjs\" tool-fail",
            "async": true
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "pre-implementer|implementer|code-reviewer|qa",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/run-logger.mjs\" subagent-start",
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "pre-implementer|implementer|code-reviewer|qa",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/run-logger.mjs\" subagent-stop",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
