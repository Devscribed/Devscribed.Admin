# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# --- Dependencies ---
node_modules/
/.pnp
.pnp.js
.pnp.*
.yarn/*
.npm

# --- Build output ---
dist/
build/
/out/
*.tsbuildinfo

# --- Next.js ---
.next/
next-env.d.ts
.vercel

# --- Tooling caches ---
.turbo/
.nx/
.eslintcache
.cache/

# --- Testing / coverage ---
coverage/
*.lcov
# Playwright (root or e2e workspace)
test-results/
playwright-report/
playwright/.cache/

# --- Environment files (keep .env.example tracked) ---
.env
.env.*
!.env.example

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/

# --- Editors / IDEs ---
.idea/
.vscode/
*.swp
*.swo

# --- OS files ---
.DS_Store
Thumbs.db
Desktop.ini

# --- Secrets / certs ---
*.pem
