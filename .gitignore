# .NET
bin/
obj/
*.user
*.suo
*.cache
*.dll
*.exe
*.pdb
.vs/

# Node
node_modules/
dist/
.next/
next-env.d.ts
*.tsbuildinfo

# Vercel
.vercel/

# Playwright
playwright/.cache/
e2e/playwright-report/
e2e/test-results/

# Local FileStorage driver — signed documents a developer or a test produced. A signed
# contract is still a signed contract; none of it belongs in version control.
.local-storage/

# Terraform — the provider lock file is deliberately NOT ignored: a plan that resolves
# different provider versions on two machines is not a plan of the same infrastructure.
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# misc
.DS_Store
*.pem
.env*.local
.env
# Scratch notes that have held live credentials before.
Info.txt
docker-compose.override.yml

# AI workflow runs. The summary of a run is worth keeping — it answers "how did this spec
# become code" in the PR. The raw journal is not: blobs hold whole tool outputs and the
# transcript snapshots hold reasoning, both measured in hundreds of megabytes per week.
.workflow/lock
.workflow/current
.workflow/runs/*/events.jsonl
.workflow/runs/*/blobs/
.workflow/runs/*/thinking/
.workflow/runs/*/.pending.json
.workflow/runs/*/stages/*.log
.workflow/runs/*/*.verdict.json.raw
# The prompt each agent was handed. Kept on the machine that ran it, because a review prompt
# carries every prior verdict and grows with the run — but `report.html` embeds the prompts it
# needs, so the committed record still answers "what did the reviewer actually see?".
.workflow/runs/*/stages/*.prompt.md

# The same rule for a refine loop, which writes the same two kinds of thing under a different
# path. Its verdicts, handoffs and reports are the record of why a spec says what it says and
# are committed; the raw agent transcripts are hundreds of kilobytes a gate and are not.
.workflow/refine/*.probe/*/*.log
.workflow/refine/*.probe/*/stages/*.log
.workflow/refine/*.probe.*/**/*.log
# Console output of a run, kept for whoever is watching it. The ledger is the record.
.workflow/refine/*.log
# Built for one reader, from files that are committed.
.workflow/refine/*.payload.json
.workflow/refine/*.report.html
# One loop per spec: the pid of whoever holds it. Meaningless on another machine.
.workflow/refine/*.lock

# Where the last local E2E run put its servers. A note for a person, not a source of
# truth: see e2e/environment.ts.
e2e/.last-ports.json

# A QA walkthrough and what it saw — copied from e2e/tests/qa-look.template.ts for one
# pass and deleted after it. Ignored rather than merely temporary: a copy left behind by a
# killed stage must not be able to reach a branch, and `*.spec.ts` under e2e/tests is what
# the deploy gate runs.
e2e/tests/qa-look.spec.ts
e2e/.qa-look/
