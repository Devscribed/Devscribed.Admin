@page "/org/{orgId:guid}/members/{memberId:guid}"
@model Devscribed.Admin.Web.Pages.Members.DetailModel
@{
    ViewData["Title"] = "Member detail";
}

<div class="page-container member-detail-page">
    <a href="/members" id="member-detail-back-link" data-testid="member-detail-back-link" class="back-link">&larr; Back to members</a>

    <div id="member-detail-loading-skeleton" data-testid="member-detail-loading-skeleton" class="skeleton member-detail-skeleton">
        <div class="skeleton-row" style="width:80px;height:80px;border-radius:50%;margin:0 auto 1rem;"></div>
        <div class="skeleton-row" style="width:200px;margin:0 auto;"></div>
        <div class="skeleton-row"></div>
        <div class="skeleton-row"></div>
    </div>

    <div id="member-detail-not-found" data-testid="member-detail-not-found" style="display:none;">Member not found</div>

    <div id="member-detail" data-testid="member-detail" class="member-detail-card" style="display:none;">
        <div class="member-detail-header">
            <div id="member-detail-avatar" data-testid="member-detail-avatar" class="avatar-circle"></div>
            <h1 id="member-detail-name" data-testid="member-detail-name"></h1>
            <div class="badges">
                <span id="member-detail-role-badge" data-testid="member-detail-role-badge" class="role-badge"></span>
                <span id="member-detail-status-badge" data-testid="member-detail-status-badge" class="status-badge removed" style="display:none;">Removed</span>
            </div>
            <div id="member-detail-joined" data-testid="member-detail-joined" class="meta-line"></div>
            <div id="member-detail-email" data-testid="member-detail-email" class="meta-line"></div>
            <div id="member-detail-timezone" data-testid="member-detail-timezone" class="meta-line"></div>
        </div>

        <div class="tab-bar">
            <button type="button" id="member-detail-tab-about" data-testid="member-detail-tab-about" class="tab active">ABOUT</button>
            <button type="button" id="member-detail-tab-vacation" data-testid="member-detail-tab-vacation" class="tab" disabled>Vacation</button>
            <button type="button" id="member-detail-tab-projects" data-testid="member-detail-tab-projects" class="tab" disabled>Projects</button>
            <button type="button" id="member-detail-tab-roles" data-testid="member-detail-tab-roles" class="tab" disabled>Roles</button>
            <button type="button" id="member-detail-tab-payments" data-testid="member-detail-tab-payments" class="tab" disabled>Payments</button>
        </div>

        <div class="member-detail-form" id="about-tab-panel">
            <div class="form-group" id="role-field-group" style="display:none;">
                <label for="member-role-select">Role</label>
                <select id="member-role-select" class="member-role-select"></select>
                <div id="role-change-guard-message" data-testid="role-change-guard-message" class="field-error" style="display:none;">Organization must retain at least one admin</div>
            </div>

            <div class="form-group" id="job-title-field-group" style="display:none;">
                <label for="job-title-input">Job title</label>
                <input type="text" id="job-title-input" data-testid="job-title-input" maxlength="200" placeholder="Enter a job title" autocomplete="off" />
                <div class="field-error" id="field-error-jobTitle" data-testid="field-error-jobTitle"></div>
            </div>

            <div class="form-group" id="job-title-readonly-group" style="display:none;">
                <label>Job title</label>
                <div id="job-title-readonly" data-testid="job-title-readonly"></div>
            </div>

            <button type="button" id="job-title-save-button" data-testid="job-title-save-button" style="display:none;">Save changes</button>
        </div>

        <div id="vacation-tab-panel" class="vacation-tab-content" style="display:none;">
            <div id="vacation-loading-skeleton" data-testid="vacation-loading-skeleton" class="skeleton" style="display:none;">
                <div class="skeleton-row"></div>
                <div class="skeleton-row"></div>
                <div class="skeleton-row"></div>
            </div>

            <div id="vacation-empty-state" data-testid="vacation-empty-state" class="vacation-empty-state" style="display:none;">
                <p id="vacation-empty-message"></p>
                <button type="button" id="vacation-setup-btn" data-testid="vacation-setup-btn" style="display:none;">Set up financials</button>
            </div>

            <div id="vacation-default-state" style="display:none;">
                <div id="vacation-financials-card" data-testid="vacation-financials-card" class="vacation-card" style="display:none;">
                    <div class="vacation-card-header">
                        <h2>Financial Settings</h2>
                        <button type="button" id="vacation-financials-edit-btn" data-testid="vacation-financials-edit-btn">Edit</button>
                    </div>
                    <div class="vacation-field-row"><span class="label">Monthly salary</span><span id="vacation-salary-value"></span></div>
                    <div class="vacation-field-row"><span class="label">Client hourly rate</span><span id="vacation-rate-value"></span></div>
                    <div class="vacation-field-row"><span class="label">Reserve %</span><span id="vacation-reserve-value"></span></div>
                    <div class="vacation-field-row"><span class="label">Days per year</span><span id="vacation-days-value"></span></div>
                </div>

                <div id="vacation-balance-card" data-testid="vacation-balance-card" class="vacation-card">
                    <div class="vacation-card-header"><h2>Vacation Balance</h2></div>
                    <div class="vacation-balance-numbers">
                        <div><div id="vacation-available-days" data-testid="vacation-available-days" class="number">0</div><div class="caption">available</div></div>
                        <div><div id="vacation-used-days" data-testid="vacation-used-days" class="number">0</div><div class="caption">used</div></div>
                        <div><div id="vacation-pending-days" data-testid="vacation-pending-days" class="number">0</div><div class="caption">pending</div></div>
                    </div>
                    <div id="vacation-balance-caption" style="text-align:center;font-size:.8125rem;color:#6b7280;"></div>
                    <div id="vacation-reserve-amount-row" style="text-align:center;margin-top:.5rem;">
                        Reserve: <span id="vacation-reserve-amount" data-testid="vacation-reserve-amount"></span>
                    </div>
                </div>

                <button type="button" id="vacation-request-btn" data-testid="vacation-request-btn" style="display:none;">Request vacation</button>

                <div id="vacation-requests-card" class="vacation-card" style="display:none;">
                    <div class="vacation-card-header"><h2 id="vacation-requests-heading">Vacation Requests</h2></div>
                    <p id="vacation-no-requests" data-testid="vacation-no-requests" style="display:none;">No vacation requests yet.</p>
                    <div id="vacation-requests-list" data-testid="vacation-requests-list"></div>
                </div>

                <div id="vacation-transactions-card" class="vacation-card" style="display:none;">
                    <div class="vacation-card-header"><h2>Reserve Transactions</h2></div>
                    <p id="vacation-no-transactions" data-testid="vacation-no-transactions" style="display:none;">No reserve transactions yet.</p>
                    <table id="vacation-transactions-table" data-testid="vacation-transactions-table" style="display:none;width:100%;">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Type</th>
                                <th>Amount</th>
                                <th>Description</th>
                                <th>Created By</th>
                            </tr>
                        </thead>
                        <tbody id="vacation-transactions-body"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="toast-member-saved" data-testid="toast-member-saved" class="toast" style="display:none;">Changes saved</div>
<div id="toast-member-detail-error" data-testid="toast-member-detail-error" class="toast" style="display:none;"></div>
<div id="toast-financials-saved" data-testid="toast-financials-saved" class="toast" style="display:none;">Financial settings saved</div>
<div id="toast-request-submitted" data-testid="toast-request-submitted" class="toast" style="display:none;">Vacation request submitted</div>
<div id="toast-request-approved" data-testid="toast-request-approved" class="toast" style="display:none;">Request approved</div>
<div id="toast-request-rejected" data-testid="toast-request-rejected" class="toast" style="display:none;">Request rejected</div>
<div id="toast-request-cancelled" data-testid="toast-request-cancelled" class="toast" style="display:none;">Request cancelled</div>

<div id="vacation-request-modal-overlay" class="modal-overlay" style="display:none;">
    <div class="modal-card" data-testid="vacation-request-modal">
        <div class="modal-header">
            <h2>Request Vacation</h2>
            <button type="button" id="vacation-request-close-button" class="modal-close" aria-label="Close">&times;</button>
        </div>

        <form id="vacation-request-form" novalidate>
            <div class="form-group">
                <label for="vacation-start-date-input">Start date</label>
                <input type="date" id="vacation-start-date-input" data-testid="vacation-start-date-input" />
                <div class="field-error" id="field-error-startDate" data-testid="field-error-startDate"></div>
            </div>

            <div class="form-group">
                <label for="vacation-end-date-input">End date</label>
                <input type="date" id="vacation-end-date-input" data-testid="vacation-end-date-input" />
                <div class="field-error" id="field-error-endDate" data-testid="field-error-endDate"></div>
            </div>

            <div>Working days: <span id="vacation-working-days-preview" data-testid="vacation-working-days-preview">0</span></div>
            <div>Available balance: <span id="vacation-available-days-preview" data-testid="vacation-available-days-preview">0</span> days</div>

            <div class="field-error" id="vacation-request-error" data-testid="vacation-request-error"></div>

            <div class="modal-actions">
                <button type="button" id="vacation-request-cancel-btn" data-testid="vacation-request-cancel-btn">Cancel</button>
                <button type="submit" id="vacation-request-submit-btn" data-testid="vacation-request-submit-btn">Submit request</button>
            </div>
        </form>
    </div>
</div>

<div id="vacation-reject-modal-overlay" class="modal-overlay" style="display:none;">
    <div class="modal-card" data-testid="vacation-reject-modal">
        <div class="modal-header">
            <h2>Reject Request</h2>
            <button type="button" id="vacation-reject-close-button" class="modal-close" aria-label="Close">&times;</button>
        </div>

        <div id="vacation-reject-summary"></div>

        <form id="vacation-reject-form" novalidate>
            <div class="form-group">
                <label for="vacation-reject-comment-input">Comment (optional)</label>
                <textarea id="vacation-reject-comment-input" data-testid="vacation-reject-comment-input" maxlength="500"></textarea>
                <div class="field-error" id="field-error-reviewerComment" data-testid="field-error-reviewerComment"></div>
            </div>

            <div class="modal-actions">
                <button type="button" id="vacation-reject-cancel-btn" data-testid="vacation-reject-cancel-btn">Cancel</button>
                <button type="submit" id="vacation-reject-confirm-btn" data-testid="vacation-reject-confirm-btn">Reject</button>
            </div>
        </form>
    </div>
</div>

<div id="vacation-financials-modal-overlay" class="modal-overlay" style="display:none;">
    <div class="modal-card" data-testid="vacation-financials-modal">
        <div class="modal-header">
            <h2>Edit Financial Settings</h2>
            <button type="button" id="vacation-financials-close-button" class="modal-close" aria-label="Close">&times;</button>
        </div>

        <form id="vacation-financials-form" novalidate>
            <div class="form-group">
                <label for="vacation-salary-input">Monthly salary</label>
                <input type="number" step="0.01" id="vacation-salary-input" data-testid="vacation-salary-input" />
                <div class="field-error" id="field-error-monthlySalary" data-testid="field-error-monthlySalary"></div>
            </div>

            <div class="form-group">
                <label for="vacation-rate-input">Client hourly rate</label>
                <input type="number" step="0.01" id="vacation-rate-input" data-testid="vacation-rate-input" />
                <div class="field-error" id="field-error-clientHourlyRate" data-testid="field-error-clientHourlyRate"></div>
            </div>

            <div class="form-group">
                <label for="vacation-currency-select">Currency</label>
                <select id="vacation-currency-select" data-testid="vacation-currency-select">
                    <option value="USD">USD</option>
                    <option value="EUR">EUR</option>
                    <option value="GBP">GBP</option>
                    <option value="PLN">PLN</option>
                    <option value="CHF">CHF</option>
                    <option value="JPY">JPY</option>
                    <option value="CAD">CAD</option>
                    <option value="AUD">AUD</option>
                </select>
                <div class="field-error" id="field-error-currency" data-testid="field-error-currency"></div>
            </div>

            <div class="form-group">
                <label for="vacation-days-input">Vacation days per year</label>
                <input type="number" step="1" id="vacation-days-input" data-testid="vacation-days-input" value="20" />
                <div class="field-error" id="field-error-vacationDaysPerYear" data-testid="field-error-vacationDaysPerYear"></div>
            </div>

            <div class="form-group">
                <label>Reserve percentage</label>
                <div class="reserve-mode-group">
                    <label><input type="radio" name="reserve-mode" id="vacation-reserve-mode-auto" data-testid="vacation-reserve-mode-auto" value="auto" checked /> Auto-calculate</label>
                    <label><input type="radio" name="reserve-mode" id="vacation-reserve-mode-manual" data-testid="vacation-reserve-mode-manual" value="manual" /> Set manually</label>
                </div>
                <input type="number" step="0.01" id="vacation-reserve-percent-input" data-testid="vacation-reserve-percent-input" disabled />
                <div id="vacation-reserve-preview" data-testid="vacation-reserve-preview"></div>
                <div class="field-error" id="field-error-vacationReservePercent" data-testid="field-error-vacationReservePercent"></div>
            </div>

            <div class="modal-actions">
                <button type="button" id="vacation-financials-cancel-btn" data-testid="vacation-financials-cancel-btn">Cancel</button>
                <button type="submit" id="vacation-financials-save-btn" data-testid="vacation-financials-save-btn">Save changes</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        window.__memberDetailOrgId = "@Model.OrganizationId";
        window.__memberDetailMemberId = "@Model.MemberId";
    </script>
    <script src="~/js/member-detail.js"></script>
    <script src="~/js/vacation-tab.js"></script>
}
