@page "/members"
@model Devscribed.Admin.Web.Pages.Members.IndexModel
@{
    ViewData["Title"] = "Members";
    var canInvite = Model.CurrentRole == "admin" || Model.CurrentRole == "manager";
}

<div class="page-container">
    <div class="page-header">
        <h1>Active members</h1>
        @if (canInvite)
        {
            <button type="button" id="invite-open-button" data-testid="invite-open-button">Invite member</button>
        }
    </div>

    <div class="members-toolbar">
        <input type="text" id="members-search-input" data-testid="members-search-input" placeholder="Search members..." autocomplete="off" />
        <label>
            <input type="checkbox" id="show-removed-checkbox" data-testid="show-removed-checkbox" />
            Show removed members
        </label>
    </div>

    <div id="members-loading-skeleton" data-testid="members-loading-skeleton" class="skeleton">
        <div class="skeleton-row"></div>
        <div class="skeleton-row"></div>
        <div class="skeleton-row"></div>
    </div>

    <div id="members-empty-state" data-testid="members-empty-state" style="display:none;">No members found</div>

    <div id="members-list" data-testid="members-list" class="members-list" style="display:none;">
        <table>
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Role</th>
                    <th>Email</th>
                    <th id="members-actions-header" style="display:none;">Actions</th>
                </tr>
            </thead>
            <tbody id="members-table-body"></tbody>
        </table>
    </div>
</div>

<div id="confirm-delete-dialog-overlay" class="modal-overlay" style="display:none;">
    <div class="modal-card" data-testid="confirm-delete-dialog">
        <div class="modal-header">
            <h2>Remove member</h2>
        </div>
        <p id="confirm-delete-body"></p>
        <div class="modal-actions">
            <button type="button" id="cancel-delete-button" data-testid="cancel-delete-button">Cancel</button>
            <button type="button" id="confirm-delete-button" data-testid="confirm-delete-button" class="destructive">Remove</button>
        </div>
    </div>
</div>

<div id="toast-member-removed" data-testid="toast-member-removed" class="toast" style="display:none;">Member removed</div>
<div id="toast-member-restored" data-testid="toast-member-restored" class="toast" style="display:none;">Member restored</div>
<div id="toast-members-error" data-testid="toast-members-error" class="toast" style="display:none;"></div>

@if (canInvite)
{
    <div id="invite-modal-overlay" class="modal-overlay" style="display:none;">
        <div class="modal-card">
            <div class="modal-header">
                <h2>Invite member</h2>
                <button type="button" id="invite-close-button" class="modal-close" aria-label="Close">&times;</button>
            </div>

            <div id="invite-error-message" data-testid="invite-error-message" class="error-banner" style="display:none;"></div>

            <form id="invite-form" data-testid="invite-form" novalidate>
                <div class="form-group">
                    <label for="invite-email">Email address</label>
                    <input type="email" id="invite-email" name="email" data-testid="invite-email-input" autocomplete="off" />
                    <div class="field-error" id="field-error-email" data-testid="field-error-email"></div>
                </div>

                <div class="form-group">
                    <label for="invite-role">Role</label>
                    <select id="invite-role" name="role" data-testid="invite-role-select">
                        @if (Model.CurrentRole == "admin")
                        {
                            <option value="admin">Admin</option>
                        }
                        <option value="manager">Manager</option>
                        <option value="user" selected>User</option>
                        <option value="viewer">Viewer</option>
                    </select>
                </div>

                <button type="submit" id="invite-submit-button" data-testid="invite-submit-button" disabled>
                    Send invitation
                </button>
            </form>
        </div>
    </div>

    <div id="toast-invite-sent" data-testid="toast-invite-sent" class="toast" style="display:none;"></div>
}

@section Scripts {
    <script>
        window.__membersOrgId = "@Model.OrganizationId";
    </script>
    <script src="~/js/members-list.js"></script>
    @if (canInvite)
    {
        <script src="~/js/members.js"></script>
    }
}
