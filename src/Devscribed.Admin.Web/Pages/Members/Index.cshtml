@page "/members"
@model Devscribed.Admin.Web.Pages.Members.IndexModel
@{
    ViewData["Title"] = "Members";
}

<div class="page-container">
    <h1>Members</h1>

    <div data-testid="members-list" class="members-list">
        <table>
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var member in Model.Members)
                {
                    <tr data-testid="member-row-@member.Id">
                        <td>@member.FirstName @member.LastName</td>
                        <td>@member.Email</td>
                        <td>@member.Role</td>
                        <td>@member.Status</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
