@page
@model Devscribed.Admin.Web.Pages.ResetPasswordModel
@{
    ViewData["Title"] = "Reset password";
}

<div class="card">
    <h1>Reset password</h1>

    <div id="reset-error-message" class="error-banner" data-testid="reset-error-message"></div>

    <form id="reset-form" data-testid="reset-form" novalidate>
        <input type="hidden" id="reset-token" name="token" value="@Model.Token" />

        <div class="field">
            <label for="password">New password</label>
            <input id="password" name="password" type="password" data-testid="reset-password-input" autocomplete="new-password" />
        </div>

        <div class="field">
            <label for="confirmPassword">Confirm new password</label>
            <input id="confirmPassword" name="confirmPassword" type="password" data-testid="reset-password-confirm-input" autocomplete="new-password" />
        </div>

        <button type="submit" id="reset-submit-button" data-testid="reset-submit-button">Reset password</button>
    </form>

    <div id="reset-success-message" class="confirmation-message" data-testid="reset-success-message"></div>

    <div class="form-links">
        <a href="/Login">Back to login</a>
    </div>
</div>

@section Scripts {
    <script src="~/js/reset-password.js" asp-append-version="true"></script>
}
