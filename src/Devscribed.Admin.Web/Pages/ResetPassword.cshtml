@page "/reset-password"
@model Devscribed.Admin.Web.Pages.ResetPasswordModel
@{
    ViewData["Title"] = "Reset password";
}

<div class="auth-container">
    <div class="auth-card">
        <h1>Reset password</h1>

        <div id="reset-error-message" data-testid="reset-error-message" class="error-banner" style="display:none;"></div>

        <form id="reset-form" data-testid="reset-form" novalidate style="display:none;">
            <div class="form-group">
                <label for="password">New password</label>
                <input type="password" id="password" name="password" data-testid="reset-password-input" autocomplete="new-password" />
                <div class="field-error" id="field-error-password" data-testid="field-error-password"></div>
            </div>

            <div class="form-group">
                <label for="passwordConfirm">Confirm password</label>
                <input type="password" id="passwordConfirm" name="passwordConfirm" data-testid="reset-password-confirm-input" autocomplete="new-password" />
                <div class="field-error" id="field-error-password-confirm" data-testid="field-error-password-confirm"></div>
            </div>

            <button type="submit" id="reset-submit" data-testid="reset-submit-button">
                Reset password
            </button>
        </form>

        <div id="reset-success-message" data-testid="reset-success-message" style="display:none;">
            Your password has been reset.
        </div>

        <p class="auth-link" id="reset-login-link-wrapper" style="display:none;">
            <a href="/login" data-testid="reset-login-link">Back to login</a>
        </p>
    </div>
</div>

@section Scripts {
    <script src="~/js/reset-password.js"></script>
}
