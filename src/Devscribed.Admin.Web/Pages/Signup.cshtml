@page "/signup"
@model Devscribed.Admin.Web.Pages.SignupModel
@{
    ViewData["Title"] = "Sign up";
}

<div class="auth-container">
    <div class="auth-card">
        <h1>Create your account</h1>

        <div id="signup-error-banner" data-testid="signup-error-banner" class="error-banner" style="display:none;"></div>

        <form id="signup-form" data-testid="signup-form" novalidate>
            <div class="form-group">
                <label for="orgName">Organization name</label>
                <input type="text" id="orgName" name="orgName" data-testid="signup-org-name-input"
                       autocomplete="organization" />
                <div class="field-error" id="field-error-orgName" data-testid="field-error-orgName"></div>
            </div>

            <div class="form-group">
                <label for="firstName">First name</label>
                <input type="text" id="firstName" name="firstName" data-testid="signup-first-name-input"
                       autocomplete="given-name" />
                <div class="field-error" id="field-error-firstName" data-testid="field-error-firstName"></div>
            </div>

            <div class="form-group">
                <label for="lastName">Last name</label>
                <input type="text" id="lastName" name="lastName" data-testid="signup-last-name-input"
                       autocomplete="family-name" />
                <div class="field-error" id="field-error-lastName" data-testid="field-error-lastName"></div>
            </div>

            <div class="form-group">
                <label for="email">Email</label>
                <input type="email" id="email" name="email" data-testid="signup-email-input"
                       autocomplete="email" />
                <div class="field-error" id="field-error-email" data-testid="field-error-email"></div>
            </div>

            <div class="form-group">
                <label for="password">Password</label>
                <div class="password-wrapper">
                    <input type="password" id="password" name="password" data-testid="signup-password-input"
                           autocomplete="new-password" />
                    <button type="button" id="password-toggle" data-testid="signup-password-toggle"
                            class="password-toggle" aria-label="Show password">
                        <svg class="eye-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                            <circle cx="12" cy="12" r="3"/>
                        </svg>
                        <svg class="eye-off-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" style="display:none;">
                            <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/>
                            <line x1="1" y1="1" x2="23" y2="23"/>
                        </svg>
                    </button>
                </div>
                <div class="field-error" id="field-error-password" data-testid="field-error-password"></div>
            </div>

            <button type="submit" id="signup-submit" data-testid="signup-submit-button" disabled>
                Create account
            </button>
        </form>

        <p class="auth-link">
            Already have an account? <a href="/login" data-testid="signup-login-link">Sign in</a>
        </p>
    </div>
</div>

@section Scripts {
    <script src="~/js/signup.js"></script>
}
