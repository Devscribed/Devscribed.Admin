@page "/login"
@model Devscribed.Admin.Web.Pages.LoginModel
@{
    ViewData["Title"] = "Sign in";
}

<div class="auth-container">
    <div class="auth-card">
        <h1>Sign in</h1>

        <div id="login-error-message" data-testid="login-error-message" class="error-banner" style="display:none;"></div>

        <form id="login-form" data-testid="login-form" novalidate>
            <div class="form-group">
                <label for="email">Email</label>
                <input type="email" id="email" name="email" data-testid="login-email-input" autocomplete="email" />
            </div>

            <div class="form-group">
                <label for="password">Password</label>
                <input type="password" id="password" name="password" data-testid="login-password-input" autocomplete="current-password" />
            </div>

            <button type="submit" id="login-submit" data-testid="login-submit-button">
                Sign in
            </button>

            <p class="auth-link">
                <a href="/forgot-password" data-testid="login-forgot-link">Forgot password?</a>
            </p>
        </form>

        <p class="auth-link">
            Don't have an account? <a href="/signup" data-testid="login-signup-link">Create an account</a>
        </p>
    </div>
</div>

@section Scripts {
    <script src="~/js/login.js"></script>
}
