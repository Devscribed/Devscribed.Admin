@page "/forgot-password"
@model Devscribed.Admin.Web.Pages.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot password";
}

<div class="auth-container">
    <div class="auth-card">
        <h1>Forgot password</h1>

        <form id="forgot-form" data-testid="forgot-form" novalidate>
            <div class="form-group">
                <label for="email">Email</label>
                <input type="email" id="email" name="email" data-testid="forgot-email-input" autocomplete="email" />
            </div>

            <button type="submit" id="forgot-submit" data-testid="forgot-submit-button">
                Send reset link
            </button>
        </form>

        <div id="forgot-confirmation-message" data-testid="forgot-confirmation-message" style="display:none;"></div>

        <p class="auth-link">
            <a href="/login" data-testid="forgot-back-link">Back to login</a>
        </p>
    </div>
</div>

@section Scripts {
    <script src="~/js/forgot-password.js"></script>
}
