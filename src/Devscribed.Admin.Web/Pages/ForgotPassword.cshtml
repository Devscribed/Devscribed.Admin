@page
@model Devscribed.Admin.Web.Pages.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot password";
}

<div class="card">
    <h1>Forgot password</h1>

    <form id="forgot-form" data-testid="forgot-form" novalidate>
        <div class="field">
            <label for="email">Email</label>
            <input id="email" name="email" type="email" data-testid="forgot-email-input" autocomplete="email" />
        </div>

        <button type="submit" id="forgot-submit-button" data-testid="forgot-submit-button">Send reset link</button>
    </form>

    <div id="forgot-confirmation-message" class="confirmation-message" data-testid="forgot-confirmation-message"></div>

    <div class="form-links">
        <a href="/Login">Back to login</a>
    </div>
</div>

@section Scripts {
    <script src="~/js/forgot-password.js" asp-append-version="true"></script>
}
