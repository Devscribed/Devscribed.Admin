@page "/account/settings"
@model Devscribed.Admin.Web.Pages.Account.SettingsModel
@{
    ViewData["Title"] = "Account settings";
}

<div class="page-container account-settings-page" data-testid="account-settings" id="account-settings" style="max-width:600px;">
    <h1>Account settings</h1>

    <div id="account-settings-loading-skeleton" class="skeleton">
        <div class="skeleton-row"></div>
        <div class="skeleton-row"></div>
        <div class="skeleton-row"></div>
    </div>

    <div id="account-settings-content" style="display:none;">
        <div class="page-header" style="margin-bottom:1.5rem;">
            <button type="button" id="change-email-open-button" data-testid="change-email-open-button">Change email</button>
            <button type="button" id="change-password-open-button" data-testid="change-password-open-button">Change password</button>
        </div>

        <div id="account-server-error" class="error-banner" style="display:none;"></div>

        <form id="account-settings-form" novalidate>
            <div class="form-group">
                <label for="edit-first-name-input">First name</label>
                <input type="text" id="edit-first-name-input" data-testid="edit-first-name-input" autocomplete="off" />
                <div class="field-error" id="field-error-firstName" data-testid="field-error-firstName"></div>
            </div>

            <div class="form-group">
                <label for="edit-last-name-input">Last name</label>
                <input type="text" id="edit-last-name-input" data-testid="edit-last-name-input" autocomplete="off" />
                <div class="field-error" id="field-error-lastName" data-testid="field-error-lastName"></div>
            </div>

            <div class="form-group">
                <label for="edit-phone-country-select">Country</label>
                <select id="edit-phone-country-select" data-testid="edit-phone-country-select">
                    <option value="">Select a country</option>
                    <option value="US">🇺🇸 +1 (US)</option>
                    <option value="CA">🇨🇦 +1 (CA)</option>
                    <option value="GB">🇬🇧 +44 (GB)</option>
                </select>
                <div class="field-error" id="field-error-phoneCountryCode" data-testid="field-error-phoneCountryCode"></div>
            </div>

            <div class="form-group">
                <label for="edit-phone-number-input">Phone number</label>
                <input type="text" id="edit-phone-number-input" data-testid="edit-phone-number-input" autocomplete="off" />
                <div class="field-error" id="field-error-phoneNumber" data-testid="field-error-phoneNumber"></div>
            </div>

            <div class="form-group">
                <label for="edit-timezone-select">Timezone</label>
                <select id="edit-timezone-select" data-testid="edit-timezone-select">
                    <option value="Pacific/Honolulu">(GMT-10:00) Pacific/Honolulu</option>
                    <option value="America/Anchorage">(GMT-9:00) America/Anchorage</option>
                    <option value="America/Los_Angeles">(GMT-7:00) America/Los_Angeles</option>
                    <option value="America/Denver">(GMT-6:00) America/Denver</option>
                    <option value="America/Chicago">(GMT-5:00) America/Chicago</option>
                    <option value="America/New_York">(GMT-4:00) America/New_York</option>
                    <option value="Europe/London">(GMT+1:00) Europe/London</option>
                    <option value="Europe/Paris">(GMT+2:00) Europe/Paris</option>
                    <option value="Europe/Moscow">(GMT+3:00) Europe/Moscow</option>
                    <option value="Asia/Kolkata">(GMT+5:30) Asia/Kolkata</option>
                    <option value="Asia/Shanghai">(GMT+8:00) Asia/Shanghai</option>
                    <option value="Asia/Tokyo">(GMT+9:00) Asia/Tokyo</option>
                    <option value="Australia/Sydney">(GMT+10:00) Australia/Sydney</option>
                </select>
                <div class="field-error" id="field-error-timezone" data-testid="field-error-timezone"></div>
            </div>

            <div class="form-group">
                <label for="edit-first-day-select">First day of week</label>
                <select id="edit-first-day-select" data-testid="edit-first-day-select">
                    <option value="Monday">Monday</option>
                    <option value="Sunday">Sunday</option>
                </select>
                <div class="field-error" id="field-error-firstDayOfWeek" data-testid="field-error-firstDayOfWeek"></div>
            </div>

            <button type="submit" id="account-save-button" data-testid="account-save-button">Save</button>
        </form>
    </div>
</div>

<div id="toast-account-saved" data-testid="toast-account-saved" class="toast" style="display:none;">Settings saved</div>

<div id="change-email-modal-overlay" class="modal-overlay" style="display:none;">
    <div class="modal-card">
        <div class="modal-header">
            <h2>Change email</h2>
            <button type="button" id="change-email-close-button" class="modal-close" aria-label="Close">&times;</button>
        </div>

        <p id="change-email-current" style="margin-bottom:1rem;font-size:.875rem;color:#6b7280;"></p>

        <div id="change-email-error" data-testid="change-email-error" class="error-banner" style="display:none;"></div>

        <form id="change-email-form" data-testid="change-email-form" novalidate>
            <div class="form-group">
                <label for="change-email-new-input">New email address</label>
                <input type="email" id="change-email-new-input" data-testid="change-email-new-input" autocomplete="off" />
                <div class="field-error" id="field-error-newEmail" data-testid="field-error-newEmail"></div>
            </div>

            <button type="submit" id="change-email-submit-button" data-testid="change-email-submit-button" disabled>
                Send confirmation
            </button>
        </form>

        <div id="change-email-confirmation-message" data-testid="change-email-confirmation-message" style="display:none;"></div>
    </div>
</div>

<div id="change-password-modal-overlay" class="modal-overlay" style="display:none;">
    <div class="modal-card">
        <div class="modal-header">
            <h2>Change password</h2>
            <button type="button" id="change-password-close-button" class="modal-close" aria-label="Close">&times;</button>
        </div>

        <div id="change-password-error" data-testid="change-password-error" class="error-banner" style="display:none;"></div>

        <form id="change-password-form" data-testid="change-password-form" novalidate>
            <div class="form-group">
                <label for="change-password-current-input">Current password</label>
                <input type="password" id="change-password-current-input" data-testid="change-password-current-input" autocomplete="current-password" />
                <div class="field-error" id="field-error-currentPassword" data-testid="field-error-currentPassword"></div>
            </div>

            <div class="form-group">
                <label for="change-password-new-input">New password</label>
                <input type="password" id="change-password-new-input" data-testid="change-password-new-input" autocomplete="new-password" />
                <div class="field-error" id="field-error-newPassword" data-testid="field-error-newPassword"></div>
            </div>

            <div class="form-group">
                <label for="change-password-confirm-input">Confirm new password</label>
                <input type="password" id="change-password-confirm-input" data-testid="change-password-confirm-input" autocomplete="new-password" />
                <div class="field-error" id="field-error-passwordConfirmation" data-testid="field-error-passwordConfirmation"></div>
            </div>

            <button type="submit" id="change-password-submit-button" data-testid="change-password-submit-button" disabled>
                Change password
            </button>
        </form>

        <div id="change-password-success-message" style="display:none;">Your password has been changed.</div>
    </div>
</div>

@section Scripts {
    <script src="~/js/account-settings.js"></script>
}
