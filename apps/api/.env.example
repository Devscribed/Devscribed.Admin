# Local development runs against the Docker Postgres from the repo-root docker-compose.yml.
# Production points at Neon's *pooled* endpoint (host suffixed `-pooler`), e.g.
#   DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/devscribed?sslmode=require&connection_limit=1&pgbouncer=true"
DATABASE_URL="postgresql://devscribed:devscribed@localhost:5433/devscribed_dev"
# Prisma Migrate must bypass the pooler, so in production this is Neon's direct endpoint
# (same host without `-pooler`). Locally it is simply the same server.
DIRECT_URL="postgresql://devscribed:devscribed@localhost:5433/devscribed_dev"
# Signing key for the session cookie — override in every non-local environment
SESSION_SECRET="dev-only-insecure-secret"
PORT=4000
WEB_ORIGIN="http://localhost:3000"

# --- Hiring ---
# Where uploaded CVs are kept. `fs` is development and tests only: the application
# refuses to start with STORAGE_PROVIDER=fs and NODE_ENV=production, because a Vercel
# function's filesystem would silently discard every CV.
STORAGE_PROVIDER="fs"
# Git-ignored, relative to apps/api.
STORAGE_FS_ROOT=".storage"
# Which calendar to talk to: `graph` or `fake`. Leave it unset and the choice follows
# GRAPH_TENANT_ID — Graph when the tenant credentials are present, the fake otherwise.
# `fake` is refused when NODE_ENV=production: a booking would create no event, so neither
# the candidate nor the interviewer would be invited.
CALENDAR_PROVIDER=""
# The Azure app registration. Application permissions, admin-consented:
# Calendars.ReadWrite, MailboxSettings.Read, User.Read.All.
GRAPH_TENANT_ID=""
GRAPH_CLIENT_ID=""
GRAPH_CLIENT_SECRET=""
# Addresses the fake calendar provider refuses to resolve, comma separated. The only way
# to see an ineligible interviewer without a real tenant.
FAKE_CALENDAR_NO_MAILBOX=""
