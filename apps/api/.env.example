# Local development runs against the Docker Postgres from the repo-root docker-compose.yml.
# A deployed environment gets this from Terraform, as an SSM SecureString parameter the
# container resolves at startup — see docs/deployment.md.
DATABASE_URL="postgresql://devscribed:devscribed@localhost:5433/devscribed_dev"
# Prisma Migrate reads DIRECT_URL and schema.prisma declares it, so it must be set. There
# is no pgbouncer in front of RDS, so deployed environments give it the same value as
# DATABASE_URL; locally it is simply the same server.
DIRECT_URL="postgresql://devscribed:devscribed@localhost:5433/devscribed_dev"
# Signing key for the session cookie — override in every non-local environment
SESSION_SECRET="dev-only-insecure-secret"
PORT=4000
WEB_ORIGIN="http://localhost:3000"

# ---------------------------------------------------------------------------------------
# Documents area (specs/documents/02) — infrastructure ports.
#
# Every port below picks its local driver whenever NODE_ENV is not `production`, so a
# fresh clone needs none of these set. They are listed because naming the default is what
# makes it a decision rather than an accident, and because the deployed values have to be
# configured somewhere — Terraform, in modules/app — and reviewed here.
# ---------------------------------------------------------------------------------------

# FileStorage driver. `local` writes under apps/api/.local-storage (gitignored) and serves
# downloads from /api/local-files; `s3` uses the per-environment bucket. Local by default.
STORAGE_DRIVER="local"
# S3 bucket holding signed documents. Only read when STORAGE_DRIVER=s3. No local default —
# there is no bucket locally. Terraform outputs the name: devscribed-documents-{env}-{account}.
DOCUMENTS_BUCKET=""
# Region for every AWS client (S3, SES). Unused locally.
AWS_REGION="us-west-1"

# Mail transport. `memory` records messages and unlocks /api/test/mail, `console` only
# logs them, `ses` sends for real. Defaults to `memory` outside production.
MAIL_TRANSPORT="memory"
# Envelope-from address for the SES transport. Must BE a verified SES identity, or be
# inside a verified domain identity, or SendEmail is refused. The account owns no domain
# yet, so deployed environments send from a verified address. Unused locally.
MAIL_FROM="ivan.demchenko.dev@gmail.com"
# SES v2 configuration set. Routes send/delivery/bounce/complaint events to SNS. Turning
# those into EnvelopeEvent rows is not deployed yet — see Known Gaps in the area README.
# Empty locally; Terraform outputs the name.
SES_CONFIGURATION_SET=""

# PdfRenderer driver. `local-chromium` resolves Chromium through playwright-core and falls
# back to a built-in single-page PDF writer if no browser is installed; `lambda` invokes a
# render function. `local-chromium` everywhere, including production: the API's container
# image carries a real browser, and the fallback writes Latin-1 only — a Cyrillic contract
# through it is mojibake. The `lambda` driver is kept because the port is what makes this
# a one-line decision.
PDF_RENDERER="local-chromium"
# Name or ARN of the render function. Only read when PDF_RENDERER=lambda.
PDF_RENDER_FUNCTION=""

# JobQueue driver. `inline` runs the handler in-process after the transaction commits;
# `sqs` publishes to the FIFO render queue. Inline by default.
JOB_QUEUE="inline"
# URL of devscribed-pdf-render-{env}.fifo. Only read when JOB_QUEUE=sqs.
PDF_RENDER_QUEUE_URL=""

# Signing transport. `internal` is the in-house Simple Electronic Signature engine and the
# only value today; a third-party adapter is a class plus a value here.
SIGNATURE_PROVIDER="internal"

# Absolute base URL of the *web* application. Signing links and local download URLs are
# built from it, so a wrong value produces links that reach nobody.
APP_PUBLIC_URL="http://localhost:3000"
# Lifetime of a signing link, in days.
SIGNING_TOKEN_TTL_DAYS=14
# Default envelope expiry, in days, applied at send. Configurable per envelope from 1-365.
ENVELOPE_EXPIRY_DAYS=30
# Bearer token for POST /api/internal/envelopes/sweep, which the EventBridge-scheduled
# sweep Lambda calls. Never exposed to the browser. In production the value lives in
# Secrets Manager and is set out of band — never in a .tfvars file.
INTERNAL_TASK_SECRET="dev-only-insecure-sweep-secret"

# ---------------------------------------------------------------------------------------
# Documents area (specs/documents/04) — signature providers.
#
# A provider is selectable when its configuration is PRESENT; that is the whole gate.
# `reachable` and `webhookRegistered` are live checks shown beside the option and never
# gates on it, because no deployed environment has a public address SignWell can reach and
# those environments run correctly on convergence alone.
# ---------------------------------------------------------------------------------------

# SignWell API key. An SSM SecureString in a deployed environment — it can create and
# destroy real contracts. Empty here: a fresh clone signs with the in-house engine, and
# the SignWell adapter simply does not register.
SIGNWELL_API_KEY=""
# Names a branding profile, so the widget carries our colours and logo rather than
# SignWell's default. Not a secret. Observed: embedded signing works without it, but a
# counterparty signing our contract should see our brand.
SIGNWELL_API_APPLICATION_ID=""
# Boolean, and it must PARSE as one at boot (validation rule 6). A malformed value throws
# at startup rather than defaulting, because defaulting to `false` would mean spending
# real money and sending real contracts on a typo. This release ships `true` everywhere.
SIGNWELL_TEST_MODE="true"
# The webhook id, which IS the only input to hash verification — see requirement 20 for
# why that is both true and not enough. SSM SecureString in a deployed environment.
SIGNWELL_WEBHOOK_SECRET=""
# The seam the integration suite and the E2E stub point elsewhere. Never changed in a
# deployed environment.
SIGNWELL_API_BASE_URL="https://www.signwell.com/api/v1"
# `http` talks to the API above; `stub` answers from memory and is refused outright when
# NODE_ENV is production. The E2E suite sets `stub`, which is what keeps that suite
# hermetic — see e2e/playwright.config.ts.
SIGNWELL_DRIVER="http"
# How old a remote envelope's last sync may be before a read re-fetches synchronously
# (requirement 24a). Behaviour-affecting, so it is identical in every environment.
PROVIDER_SYNC_STALE_SECONDS=120
