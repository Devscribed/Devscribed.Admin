# Local development uses a SQLite file; production points at Turso, e.g.
#   DATABASE_URL="libsql://teammerly-zalyz.aws-eu-west-1.turso.io"
DATABASE_URL="file:./dev.db"
# Required only for a remote libsql:// database. Mint one with:
#   turso db tokens create <database>
TURSO_AUTH_TOKEN=""
# Signing key for the session cookie — override in every non-local environment
SESSION_SECRET="dev-only-insecure-secret"
PORT=4000
WEB_ORIGIN="http://localhost:3000"
