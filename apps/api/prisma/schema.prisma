generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Neon's pooled endpoint in production, a plain local Postgres in dev and tests.
  url       = env("DATABASE_URL")
  // Migrations must bypass the pooler — pgbouncer cannot run the advisory locks and
  // DDL transactions Prisma Migrate needs. Locally both point at the same server.
  directUrl = env("DIRECT_URL")
}

/// Login credentials + the person behind them.
model Account {
  id                String    @id @default(uuid())
  /// Always stored lowercase; uniqueness is therefore case-insensitive.
  email             String    @unique
  passwordHash      String
  firstName         String
  lastName          String
  /// IANA zone auto-detected from the browser at signup.
  timezone          String?
  /// Session-revocation token. Carried in every session cookie and re-checked on each
  /// authenticated request; regenerating it invalidates every outstanding cookie at
  /// once (spec 02 requirement 12 — shared with specs 04 and 06).
  securityStamp     String    @default(uuid())
  /// Last time the calendar provider resolved this address to a tenant mailbox
  /// (hiring 00 requirement 12). A cache for the interviewer picker only — every
  /// write re-verifies, so a stale value can never authorise an assignment.
  mailboxVerifiedAt DateTime?
  createdAt         DateTime  @default(now())

  memberships             Membership[]
  passwordResetTokens     PasswordResetToken[]
  interviewerVacancies    Vacancy[]                  @relation("VacancyInterviewer")
  /// The interviews actually booked with this account, which a later reassignment of
  /// the vacancy never rewrites (hiring 07 §13.63).
  interviewerApplications Application[]              @relation("ApplicationInterviewer")
  scheduleEvents          ApplicationScheduleEvent[] @relation("ScheduleEventActor")
}

/// Single-use, time-limited password-reset grant (spec 02).
model PasswordResetToken {
  id            String    @id @default(uuid())
  accountId     String
  /// SHA-256 of the raw token, hex-encoded. The raw token exists only in the email —
  /// a database breach therefore yields nothing usable.
  tokenHash     String    @unique
  createdAt     DateTime  @default(now())
  expiresAt     DateTime
  /// Set when the token is spent; null while unused.
  usedAt        DateTime?
  /// Set when a newer request supersedes this token (requirement 8).
  isInvalidated Boolean   @default(false)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  /// Reserved by the hiring 01 migration. Nothing uploads or renders a logo in this
  /// release — the booking page's wordmark is plain type (hiring 02 requirement 2).
  logoKey   String?
  createdAt DateTime @default(now())

  memberships  Membership[]
  vacancies    Vacancy[]
  candidates   Candidate[]
  applications Application[]
  categories   Category[]
  criteria     Criterion[]
}

/// Links an account to its organization. One per account — single-org-per-user (FR-8).
model Membership {
  id             String   @id @default(uuid())
  accountId      String   @unique
  organizationId String
  /// "admin" | "member" — org control is expressed purely through the admin role (FR-7).
  role           String
  /// "active" | "invited" | "removed" — `removed` is the soft-deleted state (specs 02, 04).
  status         String
  joinedAt       DateTime @default(now())

  account      Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

/// One open position: one interviewer, one interview length, one public booking link.
model Vacancy {
  id                   String   @id @default(uuid())
  /// Carried from the first migration rather than retrofitted — see hiring 00.
  organizationId       String
  title                String
  description          String?
  /// Exactly one interviewer; their mailbox is what availability is read from.
  interviewerAccountId String
  /// 15 | 30 | 45 | 60. Enforced in application code, which owns the message.
  durationMinutes      Int
  /// "open" | "closed". No `draft`: the slug is already unguessable.
  status               String   @default("open")
  /// `slugify(title)-randomBytes(9).base64url`. Globally unique, frozen at creation,
  /// stored in plaintext — the manager has to be able to copy it again.
  publicSlug           String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  interviewer  Account           @relation("VacancyInterviewer", fields: [interviewerAccountId], references: [id])
  applications Application[]
  categories   VacancyCategory[]

  @@index([organizationId])
  @@index([interviewerAccountId])
}

/// An org-wide label on a vacancy: `React`, `Senior`, `Engineer` (hiring 06 §02).
model Category {
  id             String   @id @default(uuid())
  organizationId String
  /// Stored exactly as typed. Uniqueness is enforced case-insensitively by a
  /// `lower(name)` index the migration creates, not by this column — folding the
  /// stored value would render `Asp.Net` as `asp.net` on every screen.
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vacancies    VacancyCategory[]

  @@index([organizationId])
}

/// Assignment of a category to a vacancy. Renaming the category touches no row here,
/// which is the whole reason the assignment references the row rather than the string.
model VacancyCategory {
  vacancyId  String
  categoryId String
  assignedAt DateTime @default(now())

  vacancy  Vacancy  @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([vacancyId, categoryId])
  @@index([categoryId])
}

/// A person who has applied at least once. Never signs in; the team owns the record.
model Candidate {
  id             String   @id @default(uuid())
  organizationId String
  /// Overwritten by the latest booking (hiring 02 requirement 27) — a typo in the
  /// first booking must not be permanently uncorrectable.
  firstName      String
  lastName       String
  /// Always lowercase, matching the account rule.
  email          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  applications Application[]

  @@unique([organizationId, email])
}

/// One candidate against one vacancy: the interview, its outcome, and its board card.
model Application {
  id                   String   @id @default(uuid())
  organizationId       String
  candidateId          String
  vacancyId            String
  /// The board column itself — one field, five values, no mirrored status (hiring 05).
  status               String   @default("scheduled")
  /// Gap integer scoped to (vacancyId, status); `id` is the stable tiebreak.
  position             Int
  /// The name exactly as submitted, frozen — the candidate's display name may move on.
  submittedName        String
  start                DateTime
  end                  DateTime
  /// The IANA zone the candidate booked in, so every screen can name it.
  timeZone             String
  /// `randomBytes(16).base64url`, unique, frozen at booking, stored in **plaintext**.
  ///
  /// Plaintext follows `Vacancy.publicSlug` rather than `PasswordResetToken.tokenHash`,
  /// and the difference is not an oversight: hashing protects a credential that grants
  /// account access, where this addresses one application row that anyone holding the
  /// database already has. It would buy nothing and would cost the candidate the
  /// ability to reopen a month-old invite (hiring 07 §03.11).
  manageToken          String   @unique
  /// The interviewer this booking was actually made with, stamped here rather than
  /// resolved later through the vacancy. Reassigning a vacancy must not retroactively
  /// rewrite who held an interview that already happened (hiring 07 §13.63), and a
  /// reschedule has to reach the mailbox the event is actually in.
  interviewerAccountId String
  /// Identifier of the calendar event in the interviewer's mailbox.
  graphEventId         String?
  /// Opaque, application-generated storage key — never a path and never user input.
  cvKey                String?
  cvFileName           String?
  cvContentType        String?
  /// Recorded at upload so the card can name the file's size without reading it back
  /// out of storage (hiring 04 §API). Null on any application booked before this
  /// column existed, which the card renders as a filename with no size.
  cvSizeBytes          Int?
  /// The candidate's own note from the booking form.
  note                 String?
  /// Written during the interview (hiring 04). Shared fields, last write wins.
  interviewNotes       String?
  conclusion           String?
  /// **The interview did not take place** — and nothing about the candidate's standing
  /// (hiring 07 §01.1). Set from either side, never retroactively, and never derived by
  /// replaying `ApplicationScheduleEvent`: this flag is what the board queries.
  isCancelled          Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  organization   Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  candidate      Candidate                  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  vacancy        Vacancy                    @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  interviewer    Account                    @relation("ApplicationInterviewer", fields: [interviewerAccountId], references: [id])
  criteria       ApplicationCriterion[]
  scheduleEvents ApplicationScheduleEvent[]

  @@index([organizationId])
  @@index([candidateId])
  @@index([vacancyId, status, position])
  @@index([interviewerAccountId])
}

/// Every change to when an interview is, append-only (hiring 07 §11).
///
/// The log is the whole story rather than only its deviations, so a `booked` row is
/// written at booking. It is never replayed to derive board or card state: denormalized
/// state plus an append-only record is the split, and re-deriving a five-column kanban
/// from an event stream is not (07 §11.51).
///
/// Scope travels through `Application`, exactly as `ApplicationCriterion`'s does.
model ApplicationScheduleEvent {
  id             String    @id @default(uuid())
  applicationId  String
  /// "booked" | "rescheduled" | "cancelled".
  type           String
  /// "candidate" | "member" — attribution runs both ways (07 §11.55).
  actor          String
  /// Set when `actor = member`, null otherwise.
  actorAccountId String?
  /// Both set on `rescheduled`; `toStart` alone on `booked`; neither on `cancelled`.
  fromStart      DateTime?
  toStart        DateTime?
  /// The zone the acting party was working in, so the entry can be read back in it.
  timeZone       String
  /// Team cancellations only (07 §10.48). Never rendered candidate-side.
  reason         String?
  createdAt      DateTime  @default(now())

  application  Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actorAccount Account?    @relation("ScheduleEventActor", fields: [actorAccountId], references: [id])

  /// The card reads one application's whole log, newest first.
  @@index([applicationId, createdAt])
  @@index([actorAccountId])
}

/// Something a candidate is assessed on during an interview: `English`, `AI Skills`,
/// `Late hours availability` (hiring 06 §03).
///
/// Scoped by `organizationId` like every other hiring root. `CriterionValue` and
/// `ApplicationCriterion` inherit that scope through their parents, exactly as
/// `VacancyCategory` does — a join row's organization is not a second fact about it.
model Criterion {
  id             String   @id @default(uuid())
  organizationId String
  /// Stored exactly as typed. Uniqueness is case-insensitive through the same
  /// `lower(name)` index the categories use, created by the migration.
  name           String
  /// "scale" | "boolean" | "number" | "text". Frozen at creation (06 §03.14): every
  /// assessment lives in the column this names, so changing it would strand them.
  type           String
  /// Archived, never deleted, once assessed (06 §03.17). Reversible, and invisible only
  /// to the add-autocomplete — the filter and the existing assessments keep it.
  isArchived     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  values       CriterionValue[]
  assessments  ApplicationCriterion[]

  /// Not a rule about criteria — the key `ApplicationCriterion`'s composite foreign key
  /// points at, which is what keeps its copy of `type` honest. `id` is already unique.
  @@unique([id, type])
  @@index([organizationId])
}

/// One label on a `scale` criterion's ordered list.
///
/// Comparison uses `position`, never `label` (06 §03.15) — which is what makes renaming a
/// value free and reordering one retroactive, and why only the second is confirmed.
model CriterionValue {
  id          String @id @default(uuid())
  criterionId String
  label       String
  /// Contiguous from zero, worst to best. The whole list is renumbered on every write,
  /// so two values can never share a position and none is ever skipped.
  position    Int

  criterion   Criterion              @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  assessments ApplicationCriterion[]

  /// Again a foreign-key target rather than a rule: it is what lets an assessment's
  /// `(criterionId, valueId)` pair be checked by the database, so a value belonging to
  /// another scale cannot be stored against this criterion.
  @@unique([criterionId, id])
  @@index([criterionId, position])
}

/// One criterion assessed on one application (hiring 04 §05).
///
/// The primary key is the pair, which is what "at most once per application" means:
/// re-adding a criterion edits the row that is already there rather than adding a second.
model ApplicationCriterion {
  applicationId String
  criterionId   String
  /// A copy of the criterion's type, kept honest by a composite foreign key onto
  /// `Criterion(id, type)`. It exists so the check constraint below can be written at
  /// all — a CHECK cannot read another table — and it can never drift, because the type
  /// it copies is immutable and the foreign key would refuse the write if it moved.
  type          String
  /// Exactly one of these four is populated, and it is the one `type` names. Enforced by
  /// a check constraint, so every filter in spec 03 stays a plain indexed comparison
  /// rather than a JSON cast (04 §05.23).
  valueId       String?
  valueBool     Boolean?
  valueNumber   Float?
  valueText     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  application Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  criterion   Criterion       @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  value       CriterionValue? @relation(fields: [valueId], references: [id])

  @@id([applicationId, criterionId])
  @@index([criterionId])
  @@index([valueId])
}
