# Copy to `.env.local` and fill in. `.env.local` is git-ignored.
#
# Microsoft Graph app registration (app-only / client-credentials flow).
# The app registration needs the following APPLICATION permissions, with
# admin consent granted:
#   - Calendars.ReadWrite   (read free/busy, create/update/cancel events)
#   - MailboxSettings.Read   (read the hiring manager's working hours)
#   - User.Read.All          (resolve the mailbox by address)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# The single hiring manager whose MS 365 calendar drives availability and in
# whose calendar invites are created. In production this is an Admin Dashboard
# setting; here it is env-backed behind the SettingsRepository interface.
HIRING_MANAGER_EMAIL=
